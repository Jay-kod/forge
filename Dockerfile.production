# ==============================================================================
# Stage 1: Build Frontend Assets (Vite + Vue 3)
# ==============================================================================
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --prefer-offline --no-audit
COPY resources/ ./resources/
COPY vite.config.js tsconfig.json ./
RUN npm run build

# ==============================================================================
# Stage 2: Production PHP-FPM Application Image
# ==============================================================================
FROM php:8.2-fpm-alpine AS production

# Install system dependencies & libraries required for extensions
RUN apk update && apk add --no-cache \
    curl \
    git \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libzip-dev \
    icu-dev \
    oniguruma-dev \
    linux-headers \
    $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        bcmath \
        zip \
        intl \
        opcache \
        gd \
        pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del --purge $PHPIZE_DEPS \
    && rm -rf /var/cache/apk/*

# Install Composer
COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

# Configure OPcache for Maximum Production Performance
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.interned_strings_buffer=16'; \
    echo 'opcache.max_accelerated_files=10000'; \
    echo 'opcache.revalidate_freq=0'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.enable_cli=1'; \
    echo 'opcache.jit=tracing'; \
    echo 'opcache.jit_buffer_size=64M'; \
} > /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini

# Create non-root forge user
RUN addgroup -g 1000 forge && adduser -u 1000 -G forge -s /bin/sh -D forge

WORKDIR /var/www/html

# Copy application source code
COPY --chown=forge:forge . .

# Copy compiled frontend assets from Stage 1
COPY --from=frontend-builder --chown=forge:forge /app/public/build ./public/build

# Run composer install for production
USER forge
RUN composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist

USER root
# Ensure writable permissions for runtime storage and cache
RUN chown -R forge:forge /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

USER forge

EXPOSE 9000

CMD ["php-fpm"]
