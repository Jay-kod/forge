# ==============================================================================
# FORGE Production Environment Configuration Template
# ==============================================================================

APP_NAME=FORGE
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://forge.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging & Observability
LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Production Relational Database (MySQL 8.4+)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=forge_prod
DB_USERNAME=forge_user
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# High-Performance In-Memory Cache & Queues (Redis 7.x)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

# Multi-Provider AI Credentials (At least one required)
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_ANTHROPIC_KEY
OPENAI_API_KEY=sk-proj-REPLACE_WITH_OPENAI_KEY
GEMINI_API_KEY=AIzaSy-REPLACE_WITH_GOOGLE_GEMINI_KEY
GOOGLE_AI_API_KEY=AIzaSy-REPLACE_WITH_GOOGLE_GEMINI_KEY
AI_DEFAULT_PROVIDER=anthropic

# Live Web Search & Continuous Intelligence
TAVILY_API_KEY=tvly-REPLACE_WITH_TAVILY_API_KEY

# OAuth Identity & Social Sign-In
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_WITH_GOOGLE_SECRET
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Stripe SaaS Billing & Subscriptions (Live Mode)
STRIPE_KEY=pk_live_REPLACE_WITH_STRIPE_LIVE_PUBLISHABLE_KEY
STRIPE_SECRET=sk_live_REPLACE_WITH_STRIPE_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_LIVE_WEBHOOK_SECRET

# Email / Transactional Alerts (SMTP / SES / Mailgun)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@yourdomain.com
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="intelligence@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object Storage (AWS S3 / MinIO / Cloudflare R2)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production Build Variables
VITE_APP_NAME="${APP_NAME}"
